{
  "name": "mdl-translator",
  "version": "1.0.0",
  "description": "Convert structured Markdown-like files to self-contained static HTML",
  "type": "module",
  "bin": {
    "mdl2html": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "eg": ". examples/use.sh",
    "build": "vite build",
    "dev": "node src/cli.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{js,ts}\""
  },
  "dependencies": {
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "prettier": "^3.9.6",
    "typescript": "5.8.3",
    "vite": "^8.0.16",
    "vitest": "^3.1.1"
  }
}
